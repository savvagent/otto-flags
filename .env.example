# Copy this file to .env for local runs. dotenvy loads it but never
# overrides a variable already set in the environment, so a real deployment's
# configuration always wins over a file that got shipped by accident.

# A Postgres connection string, pointing at otto-flags' OWN database — a
# physically separate database from otto-platform's (see
# docs/specs/2026-09-15-otto-flags-design.md §3). flags-server connects as
# this role, runs flags-core's migrations against it, and then verifies that
# role's tenant isolation before calling itself ready.
FLAGS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/otto_flags

# Set to 0/false to skip running migrations at startup (e.g. a deployment
# that migrates as a separate step ahead of a rolling restart). Defaults to
# true.
FLAGS_RUN_MIGRATIONS=true

# Log verbosity, in tracing-subscriber's EnvFilter syntax. Defaults to "info".
RUST_LOG=info
