# Copy to .env for local runs. dotenvy never overrides a variable already set,
# so a deployment's real environment always wins over a stray file.

# otto-flags' OWN database (not the platform's). `podman compose up -d` starts
# one on port 15434. DATABASE_URL is also read, for `fly postgres attach`.
FLAGS_DATABASE_URL=postgres://flags:flags@localhost:15434/otto_flags

# Public origin of this service. The token audience defaults to {this}/mcp.
FLAGS_PUBLIC_URL=http://localhost:8080
# FLAGS_RESOURCE_URI=http://localhost:8080/mcp

# The otto platform (OAuth authorization server, identity, billing), and the
# two secrets it printed when this resource server was registered there:
#   otto-platform-server resource register <resource-uri> ...
#   otto-platform-server resource rotate-secret <resource-uri>   -> otto_rs_...
#   otto-platform-server resource set-webhook <resource-uri> <public-url>/platform/webhooks -> otto_whsec_...
FLAGS_PLATFORM_URL=http://localhost:8090
FLAGS_INTROSPECTION_SECRET=otto_rs_replace_me
FLAGS_PLATFORM_WEBHOOK_SECRET=otto_whsec_replace_me

# Optional.
# FLAGS_BIND=0.0.0.0:8080
# FLAGS_ALLOWED_HOSTS=otto-flags.fly.dev        # extra Host headers /mcp accepts
# FLAGS_ALLOWED_ORIGINS=                         # browser origins for /mcp; empty = no check
# FLAGS_ENFORCE_QUOTAS=false
# FLAGS_RUN_MIGRATIONS=true
# FLAGS_DB_MAX_CONNECTIONS=5
# FLAGS_LOG_FORMAT=text                          # or json
RUST_LOG=info
